{
  "name": "broadside",
  "version": "1.0.0",
  "description": "High-Contrast Editorial Publishing Platform built with Express.js, React, Prisma ORM, JWT Authentication & Context API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev:server": "node --watch src/server.js",
    "dev:client": "cd client && vite",
    "build": "cd client && vite build",
    "seed": "node prisma/seed.js",
    "db:push": "prisma db push",
    "test": "node tests/api.test.js"
  },
  "keywords": [
    "express",
    "react",
    "prisma",
    "jwt",
    "context-api",
    "editorial-broadside",
    "fullstack-javascript"
  ],
  "author": "Devis Rumi",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "prisma": "5.22.0"
  }
}
